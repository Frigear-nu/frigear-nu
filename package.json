{
  "name": "@frigear-nu/root",
  "description": "Frigear composable volunteer ecosystem.",
  "private": true,
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "postinstall": "pnpm --filter \"./packages/*\" run --if-present dev:stub",
    "cli": "node ./packages/cli/bin/cli.mjs",
    "build": "turbo run build --concurrency=4",
    "test": "turbo run test --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "lint": "turbo run lint --concurrency=4",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "build:packages": "turbo run build --filter='./packages/**' --filter='!./packages/base-layer' --concurrency=3",
    "build:website": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=6144\" turbo run build --filter=@frigear-nu/website",
    "build:website:preview": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=6144\" turbo run build --filter=@frigear-nu/website -- --preset cloudflare_module",
    "cloudflare:build": "pnpm build:website",
    "cloudflare:build:preview": "pnpm build:website:preview",
    "cloudflare:web:deploy": "npx wrangler --cwd ./apps/website deploy --config .output/server/wrangler.json && npx wrangler --cwd ./apps/website d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "cloudflare:web:deploy-preview": "npx wrangler --cwd ./apps/website d1 migrations apply DB --remote --config .output/server/wrangler.json && npx wrangler --cwd ./apps/website preview --config .output/server/wrangler.json --name \"${CLOUDFLARE_PREVIEW_NAME:?CLOUDFLARE_PREVIEW_NAME env var is required}\" --json > \"${PREVIEW_OUTPUT_FILE:?PREVIEW_OUTPUT_FILE env var is required}\"",
    "cloudflare:d1:preview:create": "bash scripts/cloudflare-preview-db.sh create",
    "cloudflare:d1:preview:delete": "bash scripts/cloudflare-preview-db.sh delete",
    "clean": "pnpm -r --parallel clean --if-present && rm -rf node_modules .data"
  },
  "bin": {
    "frigear-nu": "./packages/cli/bin/cli.mjs"
  },
  "devDependencies": {
    "release-it": "^21.1.0",
    "turbo": "^2.11.7",
    "wrangler": "^4.148.0"
  }
}
