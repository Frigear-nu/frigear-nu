{
  "name": "@frigear-nu/root",
  "description": "Frigear composable volunteer ecosystem",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "cli": "node ./packages/cli/bin/cli.mjs",
    "test": "pnpm -r --parallel test --if-present",
    "typecheck": "pnpm -r --parallel typecheck --if-present",
    "lint": "pnpm -r --parallel lint --if-present",
    "lint:fix": "pnpm -r --parallel lint:fix --if-present",
    "build:packages": "pnpm --filter './packages/**' build --if-present",
    "build:website": "pnpm --filter @frigear-nu/website build --if-present",
    "cloudflare:build": "pnpm build:packages && pnpm build:website",
    "cloudflare:web:deploy": "npx wrangler --cwd ./apps/website deploy && npx wrangler --cwd ./apps/website d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "cloudflare:web:deploy-preview": "npx wrangler --cwd ./apps/website d1 migrations apply DB --remote && pnpm exec wrangler --cwd .output versions upload'",
    "clean": "pnpm -r --parallel clean --if-present && rm -rf node_modules .data"

  },
  "bin": {
    "frigear-nu": "./packages/cli/bin/cli.mjs"
  },
  "devDependencies": {
    "release-it": "^21.1.0"
  }
}
