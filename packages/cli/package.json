{
  "name": "@frigear-nu/cli",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Frigear CLI: scaffold projects, apps and modules, and add Frigear modules to an app.",
  "author": {
    "name": "Frigear",
    "email": "kontakt@frigear.nu",
    "url": "https://frigear.nu"
  },
  "homepage": "https://docs.frigear.dev/contribute/tooling/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0"
  },
  "bin": {
    "frigear-nu": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "frigear-nu": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node bin/cli.mjs",
    "build": "unbuild",
    "prepack": "unbuild",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "giget": "^3.3.1",
    "magicast": "^0.5.5",
    "nypm": "^0.6.10",
    "pkg-types": "^2.4.0",
    "scule": "^1.3.0"
  },
  "devDependencies": {
    "@frigear-nu/eslint-config": "workspace:^",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "typescript": "catalog:",
    "unbuild": "^3.6.1",
    "vitest": "catalog:"
  }
}
