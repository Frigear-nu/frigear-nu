{
  "name": "@frigear-nu/payments",
  "version": "0.2.3",
  "description": "One-time payments (Stripe Checkout, refunds and payment lifecycle hooks) for the frigear ecosystem, built on @frigear-nu/stripe.",
  "homepage": "https://docs.frigear.dev/modules/commerce/payments",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/payments"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/module.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/index.ts",
      "import": "./src/runtime/utils/index.ts",
      "default": "./src/runtime/utils/index.ts"
    },
    "./api": {
      "types": "./src/runtime/utils/api.ts",
      "import": "./src/runtime/utils/api.ts",
      "default": "./src/runtime/utils/api.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/index.d.ts",
        "import": "./dist/runtime/utils/index.js",
        "default": "./dist/runtime/utils/index.js"
      },
      "./api": {
        "types": "./dist/runtime/utils/api.d.ts",
        "import": "./dist/runtime/utils/api.js",
        "default": "./dist/runtime/utils/api.js"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/auth": "workspace:^",
    "@frigear-nu/mcp": "workspace:^",
    "@frigear-nu/module-kit": "workspace:^",
    "@frigear-nu/stripe": "workspace:^",
    "@frigear-nu/ui": "workspace:^",
    "@frigear-nu/users": "workspace:^",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "h3": "^1.15.11",
    "stripe": "^23.0.0",
    "unstorage": "^1.17.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@frigear-nu/widget": "workspace:^",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:"
  },
  "peerDependenciesMeta": {
    "@frigear-nu/widget": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@frigear-nu/widget": "workspace:^",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "changelogen": "^0.6.2",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
