{
  "name": "@frigear-nu/oauth-client",
  "version": "0.1.0",
  "description": "OAuth 2.1 / OpenID Connect public client with PKCE for Nuxt SPAs and Capacitor apps: discovery, rotating refresh tokens, secure storage, an authorized $api and drop-in sign-in pages. The core works without Nuxt.",
  "homepage": "https://docs.frigear.dev/modules/oauth-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/oauth-client"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/module.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./core": {
      "types": "./src/runtime/core/index.ts",
      "import": "./src/runtime/core/index.ts",
      "default": "./src/runtime/core/index.ts"
    },
    "./capacitor": {
      "types": "./src/runtime/capacitor/index.ts",
      "import": "./src/runtime/capacitor/index.ts",
      "default": "./src/runtime/capacitor/index.ts"
    },
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./core": {
        "types": "./dist/runtime/core/index.d.ts",
        "import": "./dist/runtime/core/index.js",
        "default": "./dist/runtime/core/index.js"
      },
      "./capacitor": {
        "types": "./dist/runtime/capacitor/index.d.ts",
        "import": "./dist/runtime/capacitor/index.js",
        "default": "./dist/runtime/capacitor/index.js"
      },
      "./types": {
        "types": "./dist/types.d.mts"
      }
    },
    "main": "./dist/module.mjs",
    "types": "./dist/types.d.mts",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ],
        "core": [
          "./dist/runtime/core/index.d.ts"
        ],
        "capacitor": [
          "./dist/runtime/capacitor/index.d.ts"
        ],
        "types": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:^",
    "@nuxt/kit": "catalog:",
    "defu": "^6.1.4"
  },
  "peerDependencies": {
    "@aparajita/capacitor-secure-storage": ">=8.0.0",
    "@capacitor/app": ">=8.0.0",
    "@capacitor/browser": ">=8.0.0",
    "@capacitor/core": ">=8.0.0",
    "@capacitor/preferences": ">=8.0.0",
    "@nuxt/ui": "catalog:"
  },
  "peerDependenciesMeta": {
    "@aparajita/capacitor-secure-storage": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/browser": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
