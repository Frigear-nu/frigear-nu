{
  "name": "@frigear-nu/users",
  "version": "1.0.0",
  "description": "A module for managing the users in the main frigear app.",
  "repository": "your-org/@frigear-nu/users",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "postinstall": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "^4.5.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "nuxt-auth-utils": "^0.5.30",
    "zod": "^4.6.5",
    "scule": "^1.3.0"
  },
  "peerDependencies": {
    "@nuxthub/core": "^0.10.8",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@nuxt/ui": "^4.10.0"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxthub/core": "^0.10.8",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "@nuxt/ui": "^4.11.0"
  }
}
