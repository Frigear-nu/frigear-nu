{
  "name": "@frigear-nu/auth",
  "version": "0.3.4",
  "description": "Authentication for the frigear ecosystem: server-side sign-in flows (password, magic link, OAuth, passkeys), user API tokens and a shared requireAuth with scopes, or a public PKCE client mode for SPAs and Capacitor apps.",
  "homepage": "https://docs.frigear.dev/modules/identity/auth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frigear-nu/frigear-nu.git",
    "directory": "packages/auth"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/index.ts",
      "import": "./src/runtime/utils/index.ts",
      "default": "./src/runtime/utils/index.ts"
    },
    "./api": {
      "types": "./src/runtime/utils/api.ts",
      "import": "./src/runtime/utils/api.ts",
      "default": "./src/runtime/utils/api.ts"
    },
    "./mode": {
      "types": "./src/runtime/mode.ts",
      "import": "./src/runtime/mode.ts",
      "default": "./src/runtime/mode.ts"
    },
    "./client-core": {
      "types": "./src/runtime/client/core/index.ts",
      "import": "./src/runtime/client/core/index.ts",
      "default": "./src/runtime/client/core/index.ts"
    },
    "./capacitor": {
      "types": "./src/runtime/client/capacitor/index.ts",
      "import": "./src/runtime/client/capacitor/index.ts",
      "default": "./src/runtime/client/capacitor/index.ts"
    },
    "./client-types": {
      "types": "./src/runtime/client/types.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/index.d.ts",
        "import": "./dist/runtime/utils/index.js",
        "default": "./dist/runtime/utils/index.js"
      },
      "./api": {
        "types": "./dist/runtime/utils/api.d.ts",
        "import": "./dist/runtime/utils/api.js",
        "default": "./dist/runtime/utils/api.js"
      },
      "./mode": {
        "types": "./dist/runtime/mode.d.ts",
        "import": "./dist/runtime/mode.js",
        "default": "./dist/runtime/mode.js"
      },
      "./client-core": {
        "types": "./dist/runtime/client/core/index.d.ts",
        "import": "./dist/runtime/client/core/index.js",
        "default": "./dist/runtime/client/core/index.js"
      },
      "./capacitor": {
        "types": "./dist/runtime/client/capacitor/index.d.ts",
        "import": "./dist/runtime/client/capacitor/index.js",
        "default": "./dist/runtime/client/capacitor/index.js"
      },
      "./client-types": {
        "types": "./dist/runtime/client/types.d.ts"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ],
        "mode": [
          "./dist/runtime/mode.d.ts"
        ],
        "client-core": [
          "./dist/runtime/client/core/index.d.ts"
        ],
        "capacitor": [
          "./dist/runtime/client/capacitor/index.d.ts"
        ],
        "client-types": [
          "./dist/runtime/client/types.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:^",
    "@frigear-nu/notify": "workspace:^",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "catalog:",
    "defu": "^6.1.4",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "h3": "^1.15.11",
    "jose": "^6.1.0",
    "nuxt-auth-utils": "^0.5.30",
    "scule": "^1.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@aparajita/capacitor-secure-storage": ">=8.0.0",
    "@capacitor/app": ">=8.0.0",
    "@capacitor/browser": ">=8.0.0",
    "@capacitor/core": ">=8.0.0",
    "@capacitor/preferences": ">=8.0.0",
    "@frigear-nu/email-templates": "workspace:^",
    "@frigear-nu/menu": "workspace:^",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@frigear-nu/email-templates": "workspace:^",
    "@frigear-nu/menu": "workspace:^",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "unstorage": "^1.17.5",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependenciesMeta": {
    "@aparajita/capacitor-secure-storage": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/browser": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    },
    "@frigear-nu/email-templates": {
