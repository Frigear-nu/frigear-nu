{
  "name": "@frigear-nu/auth",
  "version": "0.2.1",
  "description": "Authentication for the frigear ecosystem: sign-in flows (password, magic link, OAuth, passkeys), user API tokens, and a shared requireAuth for sessions, tokens and OAuth access tokens, with scopes.",
  "homepage": "https://docs.frigear.dev/modules/auth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/auth"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/index.ts",
      "import": "./src/runtime/utils/index.ts",
      "default": "./src/runtime/utils/index.ts"
    },
    "./api": {
      "types": "./src/runtime/utils/api.ts",
      "import": "./src/runtime/utils/api.ts",
      "default": "./src/runtime/utils/api.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/index.d.ts",
        "import": "./dist/runtime/utils/index.js",
        "default": "./dist/runtime/utils/index.js"
      },
      "./api": {
        "types": "./dist/runtime/utils/api.d.ts",
        "import": "./dist/runtime/utils/api.js",
        "default": "./dist/runtime/utils/api.js"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "postinstall": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:*",
    "@frigear-nu/notify": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "h3": "^1.15.11",
    "jose": "^6.1.0",
    "nuxt-auth-utils": "^0.5.30",
    "scule": "^1.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@frigear-nu/email-templates": "workspace:*",
    "@frigear-nu/menu": "workspace:*",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0"
  },
  "devDependencies": {
    "@frigear-nu/email-templates": "workspace:*",
    "@frigear-nu/menu": "workspace:*",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependenciesMeta": {
    "@frigear-nu/email-templates": {
      "optional": true
    },
    "@frigear-nu/menu": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    },
    "@simplewebauthn/browser": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    }
  }
}
