    },
    "@frigear-nu/menu": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    },
    "@nuxthub/core": {
      "optional": true
    },
    "@simplewebauthn/browser": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    }
  }
}
