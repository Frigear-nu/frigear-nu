{
  "name": "@frigear-nu/authorization",
  "version": "0.2.2",
  "description": "Policy-based authorization (abilities, resolvers, route rules, <Can>) for the frigear ecosystem, built on @frigear-nu/users.",
  "homepage": "https://docs.frigear.dev/modules/identity/authorization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/authorization"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/module.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/index.ts",
      "import": "./src/runtime/utils/index.ts",
      "default": "./src/runtime/utils/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/index.d.ts",
        "import": "./dist/runtime/utils/index.js",
        "default": "./dist/runtime/utils/index.js"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:^",
    "@frigear-nu/auth": "workspace:^",
    "@frigear-nu/users": "workspace:^",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "@nuxthub/core": "catalog:"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nuxthub/core": {
      "optional": true
    }
  }
}
