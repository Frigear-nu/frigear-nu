{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": true,
    "commitMessage": "chore(release): @frigear-nu/frigear-resource@${version}",
    "tagName": "frigear-resource@${version}",
    "tagAnnotation": "@frigear-nu/frigear-resource@${version}",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "@frigear-nu/frigear-resource@${version}"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": "pnpm run build --if-present",
    "after:release": "bash ../../scripts/npm-publish.sh"
  }
}
