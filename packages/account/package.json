{
  "name": "@frigear-nu/account",
  "version": "0.3.0",
  "description": "A module for managing the account area (profile, email, password, security) in the main frigear app.",
  "homepage": "https://docs.frigear.dev/modules/identity/account",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frigear-nu/frigear-nu.git",
    "directory": "packages/account"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/module.ts"
    },
    "./composables": "./src/runtime/app/composables/index.ts",
    "./composables/*": "./src/runtime/app/composables/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:^",
    "@frigear-nu/auth": "workspace:^",
    "@frigear-nu/ui": "workspace:^",
    "@frigear-nu/users": "workspace:^",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "catalog:",
    "@vueuse/core": "^15.0.0",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@frigear-nu/authorization": "workspace:^",
    "@frigear-nu/menu": "workspace:^",
    "@frigear-nu/widget": "workspace:^",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:"
  },
  "peerDependenciesMeta": {
    "@frigear-nu/authorization": {
      "optional": true
    },
    "@frigear-nu/menu": {
      "optional": true
    },
    "@frigear-nu/widget": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@frigear-nu/authorization": "workspace:^",
    "@frigear-nu/menu": "workspace:^",
    "@frigear-nu/widget": "workspace:^",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "changelogen": "^0.6.2",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
