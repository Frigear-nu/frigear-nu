{
  "name": "@frigear-nu/notify",
  "version": "0.1.3",
  "type": "module",
  "description": "Email, SMS and generic notification dispatch (pluggable drivers) Nuxt module, shared across Frigear modules.",
  "license": "MIT",
  "homepage": "https://docs.frigear.dev/modules/notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/notify"
  },
  "main": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs"
      },
      "./types": {
        "types": "./dist/types.d.mts"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "defu": "^6.1.7",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "nuxt": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
