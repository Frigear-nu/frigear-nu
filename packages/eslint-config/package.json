{
  "name": "@frigear-nu/eslint-config",
  "version": "0.0.3",
  "description": "Shared ESLint flat config for Frigear packages and Nuxt apps.",
  "homepage": "https://docs.frigear.dev/packages/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "eslint .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nuxt/eslint-config": "^1.17.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0||^10.0.0"
  }
}
