{
  "name": "@frigear-nu/ui",
  "version": "0.2.5",
  "description": "Shared UI components and composables for Frigear Nuxt applications, built on Nuxt UI.",
  "license": "MIT",
  "homepage": "https://docs.frigear.dev/modules/interface/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./src/module.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./components/*": "./src/runtime/components/global/*.vue",
    "./composables": "./src/runtime/composables/index.ts",
    "./composables/*": "./src/runtime/composables/*.ts",
    "./translated": "./src/runtime/translated.ts",
    "./markdown": "./src/runtime/markdown.ts",
    "./money": "./src/runtime/shared/money.ts",
    "./utils": "./src/runtime/utils/index.ts",
    "./types": "./src/runtime/types.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./components/*": "./dist/runtime/components/global/*.vue",
      "./composables": "./dist/runtime/composables/index.js",
      "./composables/*": "./dist/runtime/composables/*.js",
      "./translated": "./dist/runtime/translated.js",
      "./markdown": "./dist/runtime/markdown.js",
      "./money": "./dist/runtime/shared/money.js",
      "./utils": "./dist/runtime/utils/index.js",
      "./types": "./dist/runtime/types.js"
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "main": "./src/module.ts",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev:playground": "nuxt dev playground",
    "build:playground": "nuxt build playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground"
  },
  "dependencies": {
    "@frigear-nu/module-kit": "workspace:^",
    "@nuxt/kit": "catalog:",
    "@vueuse/core": "^13.5.0",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@frigear-nu/eslint-config": "workspace:^",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxt/ui": "catalog:",
    "eslint": "catalog:",
    "monaco-editor": "^0.56.0",
    "nuxt": "catalog:",
    "nuxt-monaco-editor": "^1.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/ui": "catalog:",
    "nuxt": "catalog:",
    "vue": "3.x",
    "monaco-editor": "^0.56.0",
    "nuxt-monaco-editor": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    },
    "nuxt-monaco-editor": {
      "optional": true
    }
  }
}
