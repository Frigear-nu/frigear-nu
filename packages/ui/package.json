{
  "name": "@frigear-nu/ui",
  "version": "0.0.2",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./components/*": "./src/runtime/components/global/*.vue",
    "./composables": "./src/runtime/composables/index.ts",
    "./composables/*": "./src/runtime/composables/*.ts"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:prepare": "nuxt-module-builder prepare",
    "dev:playground": "nuxt dev playground",
    "build:playground": "nuxt build playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.0",
    "@vueuse/core": "^13.5.0",
    "cron-parser": "^5.10.0",
    "defu": "^6.1.4",
    "yaml": "^2.7.1",
    "nuxt-monaco-editor": "^1.4.1",
    "monaco-editor": "^0.56.0",
    "@tanstack/vue-table": "^8.21.3",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.10.0",
    "@frigear-nu/eslint-config": "workspace:*",
    "eslint": "^10.8.1",
    "nuxt": "catalog:",
    "vitest": "^5.0.0",
    "@nuxt/module-builder": "^1.0.3"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.10.0",
    "nuxt": "^3.0.0 || ^4.0.0",
    "vue": "3.x"
  }
}
