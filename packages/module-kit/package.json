{
  "name": "@frigear-nu/module-kit",
  "version": "1.3.4",
  "type": "module",
  "private": false,
  "description": "Frigear Module Kit",
  "url": "https://docs.frigear.dev/modules/platform/module-kit",
  "author": {
    "name": "Frigear",
    "email": "kontakt@frigear.nu",
    "url": "https://frigear.nu"
  },
  "homepage": "https://docs.frigear.dev/modules/platform/module-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frigear-nu/frigear-nu.git",
    "directory": "packages/module-kit"
  },
  "license": "MIT",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/module.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/index.ts",
      "import": "./src/runtime/utils/index.ts",
      "default": "./src/runtime/utils/index.ts"
    },
    "./schedule": {
      "types": "./src/runtime/utils/schedule.ts",
      "import": "./src/runtime/utils/schedule.ts",
      "default": "./src/runtime/utils/schedule.ts"
    },
    "./server": {
      "types": "./src/runtime/server/index.ts",
      "import": "./src/runtime/server/index.ts",
      "default": "./src/runtime/server/index.ts"
    },
    "./testing": {
      "types": "./src/runtime/testing/index.ts",
      "import": "./src/runtime/testing/index.ts",
      "default": "./src/runtime/testing/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./src/module.ts"
      ],
      "utils": [
        "./src/runtime/utils/index.ts"
      ],
      "schedule": [
        "./src/runtime/utils/schedule.ts"
      ],
      "server": [
        "./src/runtime/server/index.ts"
      ],
      "testing": [
        "./src/runtime/testing/index.ts"
      ]
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs",
        "default": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/index.d.ts",
        "import": "./dist/runtime/utils/index.js",
        "default": "./dist/runtime/utils/index.js"
      },
      "./schedule": {
        "types": "./dist/runtime/utils/schedule.d.ts",
        "import": "./dist/runtime/utils/schedule.js",
        "default": "./dist/runtime/utils/schedule.js"
      },
      "./server": {
        "types": "./dist/runtime/server/index.d.ts",
        "import": "./dist/runtime/server/index.js",
        "default": "./dist/runtime/server/index.js"
      },
      "./testing": {
        "types": "./dist/runtime/testing/index.d.ts",
        "import": "./dist/runtime/testing/index.js",
        "default": "./dist/runtime/testing/index.js"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ],
        "utils": [
          "./dist/runtime/utils/index.d.ts"
        ],
        "schedule": [
          "./dist/runtime/utils/schedule.d.ts"
        ],
        "server": [
          "./dist/runtime/server/index.d.ts"
        ],
        "testing": [
          "./dist/runtime/testing/index.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare && nuxt-module-build build",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxthub/core": "catalog:",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "oxc-parser": "^0.157.0",
    "scule": "^1.3.0",
    "ufo": "^1.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "@vue/compiler-dom": "^3.5.45",
    "changelogen": "^0.6.2",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-kit": "catalog:"
  }
}
