{
  "name": "@frigear-nu/oauth-resource",
  "version": "0.1.7",
  "description": "OAuth 2.0 resource server for Nuxt: verifies RFC 9068 at+jwt access tokens against the issuer's JWKS, maps scopes to the auth principal, provisions users and adds bearer-only CORS for the mobile app. Defaults to frigear.nu.",
  "homepage": "https://docs.frigear.dev/modules/identity/oauth-resource",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frigear-nu/frigear-nu.git",
    "directory": "packages/oauth-resource"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/index.ts",
      "import": "./src/runtime/utils/index.ts",
      "default": "./src/runtime/utils/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/index.d.ts",
        "import": "./dist/runtime/utils/index.js",
        "default": "./dist/runtime/utils/index.js"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/auth": "workspace:^",
    "@frigear-nu/module-kit": "workspace:^",
    "@frigear-nu/users": "workspace:^",
    "@nuxt/kit": "catalog:",
    "h3": "^1.15.11",
    "jose": "^6.2.15"
  },
  "peerDependencies": {
    "@nuxthub/core": "catalog:"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
