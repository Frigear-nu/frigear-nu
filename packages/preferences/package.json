{
  "name": "@frigear-nu/preferences",
  "version": "0.1.5",
  "description": "Typed per-user preferences that modules and the host app register, stored on the user and optionally forwarded to OAuth applications as claims.",
  "homepage": "https://docs.frigear.dev/modules/preferences",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frigear-nu/frigear-nu.git",
    "directory": "packages/preferences"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/module.ts"
    },
    "./utils": {
      "types": "./src/runtime/utils/build.ts",
      "import": "./src/runtime/utils/build.ts"
    },
    "./api": {
      "types": "./src/runtime/utils/api.ts",
      "import": "./src/runtime/utils/api.ts",
      "default": "./src/runtime/utils/api.ts"
    },
    "./define": {
      "types": "./src/runtime/define.ts",
      "import": "./src/runtime/define.ts"
    },
    "./composables": "./src/runtime/app/composables/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "import": "./dist/module.mjs"
      },
      "./utils": {
        "types": "./dist/runtime/utils/build.d.ts",
        "import": "./dist/runtime/utils/build.js"
      },
      "./api": {
        "types": "./dist/runtime/utils/api.d.ts",
        "import": "./dist/runtime/utils/api.js",
        "default": "./dist/runtime/utils/api.js"
      },
      "./define": {
        "types": "./dist/runtime/define.d.ts",
        "import": "./dist/runtime/define.js"
      }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
      "*": {
        ".": [
          "./dist/types.d.mts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:stub": "nuxt-module-build build --stub && nuxt prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd test/fixtures/basic && vue-tsc --noEmit"
  },
  "dependencies": {
    "@frigear-nu/auth": "workspace:^",
    "@frigear-nu/module-kit": "workspace:^",
    "@frigear-nu/users": "workspace:^",
    "@libsql/client": "^0.18.0",
    "@nuxt/kit": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@frigear-nu/oauth-server": ">=0.0.1",
    "@nuxthub/core": "catalog:"
  },
  "peerDependenciesMeta": {
    "@frigear-nu/oauth-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@frigear-nu/oauth-server": "workspace:^",
    "@nuxt/devtools": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxthub/core": "catalog:",
    "@types/node": "catalog:",
    "changelogen": "^0.6.2",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
