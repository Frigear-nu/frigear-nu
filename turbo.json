{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**", "!**/dist/**", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**"],
      "outputs": []
    }
  }
}
