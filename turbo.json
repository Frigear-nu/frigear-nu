{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.nuxt/**", "!**/.output/**", "!**/.data/**"],
      "outputs": []
    }
  }
}
