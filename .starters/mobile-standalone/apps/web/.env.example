# Encrypts the session cookie; at least 32 characters. `pnpm prepare:env` fills in a random one when it is empty.
NUXT_SESSION_PASSWORD=

# Comma separated emails that are always admins. Register with one of them, then sign in again.
NUXT_ACL_ADMINS=

# Signs the OAuth tokens: a PKCS#8 RSA private key on one line (`\n` for newlines). `pnpm prepare:env` generates one
# when it is empty. Under `nuxt dev` without one, a dev key is kept in .data/oauth-server/dev-key.pem instead.
# Use a different key per environment and keep it secret.
NUXT_OAUTH_SERVER_PRIVATE_KEY=
