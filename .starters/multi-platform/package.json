{
  "name": "frigear-multi-platform-workspace",
  "private": true,
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/web --filter ./apps/mobile --filter ./apps/desktop dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:mobile": "pnpm --parallel --filter ./apps/web --filter ./apps/mobile dev",
    "dev:desktop": "pnpm --parallel --filter ./apps/web --filter ./apps/desktop dev",
    "dev:lan": "pnpm --filter ./apps/web dev --host 0.0.0.0",
    "build": "pnpm -r build",
    "build:local": "pnpm --filter ./apps/desktop run build:local",
    "preview": "pnpm --filter ./apps/web preview",
    "prepare:env": "node scripts/prepare-env.mjs",
    "db:generate": "pnpm --filter ./apps/web --filter ./apps/desktop run db:generate",
    "db:migrate": "pnpm --filter ./apps/web db:migrate",
    "mobile:native": "pnpm --filter ./apps/mobile run native",
    "mobile:doctor": "pnpm --filter ./apps/mobile run doctor",
    "mobile:sync": "pnpm --filter ./apps/mobile run cap:sync",
    "mobile:ios": "pnpm --filter ./apps/mobile run ios:run",
    "mobile:ios:device": "pnpm --filter ./apps/mobile run ios:device",
    "mobile:android": "pnpm --filter ./apps/mobile run android:run",
    "desktop:doctor": "pnpm --filter ./apps/desktop run doctor",
    "desktop:init": "pnpm --filter ./apps/desktop run native",
    "desktop:sync": "pnpm --filter ./apps/desktop run native:sync",
    "desktop:dev": "pnpm --filter ./apps/desktop run native:dev",
    "desktop:build": "pnpm --filter ./apps/desktop run native:build",
    "desktop:sidecar": "pnpm --filter ./apps/desktop run sidecar",
    "test": "pnpm -r --parallel test",
    "typecheck": "pnpm -r --parallel typecheck",
    "typecheck:local": "pnpm --filter ./apps/desktop run typecheck:local",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "clean": "pnpm -r --parallel clean --if-present && rm -rf node_modules .data"
  }
}
