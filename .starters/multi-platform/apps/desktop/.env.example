# How the app gets its pages. `remote`: a static SPA that signs in at apps/web. `local`: the whole app with its own
# server and sqlite database, bundled as a sidecar (needs Bun to build), signing in at apps/web in the system browser.
# Run `pnpm desktop:init --force` after switching, so src-tauri/ matches the mode.
DESKTOP_MODE=remote

# --- Remote mode ---------------------------------------------------------------------------------------------------
# The OAuth server (issuer) the app signs in at, and the API it calls with the access token: apps/web. Baked into the
# build. In production, apps/web's https origin.
NUXT_PUBLIC_AUTHENTICATION_CLIENT_ISSUER=http://localhost:3000
NUXT_PUBLIC_AUTHENTICATION_CLIENT_API_BASE=http://localhost:3000

# Overrides of identity.ts, for example per environment. Leave them commented out to use identity.ts.
# NUXT_PUBLIC_AUTHENTICATION_CLIENT_CLIENT_ID=desktop
# NUXT_PUBLIC_AUTHENTICATION_CLIENT_SCOPE=openid profile email

# --- Local mode ----------------------------------------------------------------------------------------------------
# The issuer the bundled server signs people in at (the browser handoff): apps/web. Baked into the build. In
# production, apps/web's https origin.
NUXT_FRIGEAR_SSO_URL=http://localhost:3000

# Override of identity.ts (`localClientId`): the public client apps/web registers for local mode. No secret.
# NUXT_FRIGEAR_SSO_CLIENT_ID=desktop-local

# Seals the session cookie under `pnpm dev`. `pnpm prepare:env` fills in a random one. The built app generates its own
# secrets on first start, in the user's app-data folder, so nothing here ships with it.
NUXT_APP_SECRET=
