# The OAuth server (issuer) the app signs in at, and the API it calls with the access token. Baked into the build.
# The standalone starter's apps/web: http://localhost:3000 (a device build rewrites localhost with MOBILE_LAN=1).
# frigear.nu or your own issuer: its https origin, and register the redirect URIs from identity.ts there.
NUXT_PUBLIC_OAUTH_CLIENT_ISSUER=http://localhost:3000
NUXT_PUBLIC_OAUTH_CLIENT_API_BASE=http://localhost:3000

# Overrides of identity.ts, for example per environment. Leave them commented out to use identity.ts.
# Add offline_access for issuers that only issue a refresh token for it (Keycloak, Auth0, ...).
# NUXT_PUBLIC_OAUTH_CLIENT_CLIENT_ID=mobile
# NUXT_PUBLIC_OAUTH_CLIENT_SCOPE=openid profile email offline_access
