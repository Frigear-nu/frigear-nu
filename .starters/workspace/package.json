{
  "name": "frigear-workspace",
  "private": true,
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter ./apps/web preview",
    "prepare:env": "node scripts/prepare-env.mjs",
    "db:generate": "pnpm --filter ./apps/web db:generate",
    "db:migrate": "pnpm --filter ./apps/web db:migrate",
    "test": "pnpm -r --parallel test",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "clean": "pnpm -r --parallel clean --if-present && rm -rf node_modules .data"
  }
}
