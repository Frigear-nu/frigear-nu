# The website the app signs in at (the issuer), calls (`/api/...`) and opens pages on. Baked into the build.

# Development: the website's dev server (`pnpm dev`, http://localhost:3000; a device build rewrites localhost with
# MOBILE_LAN=1), with its configured client `mobile` (identity.ts).
NUXT_PUBLIC_AUTHENTICATION_CLIENT_ISSUER=http://localhost:3000
NUXT_PUBLIC_AUTHENTICATION_CLIENT_API_BASE=http://localhost:3000

# Release builds: the website from main, and the client id of the app registered on that website. The id is set in the
# release environment, never committed; it replaces identity.ts's `mobile`. For a phone build against production, put
# these three in apps/mobile/.env.production (gitignored) and run `pnpm mobile:ios:prod`.
# NUXT_PUBLIC_AUTHENTICATION_CLIENT_ISSUER=https://frigear-nu.frigear.workers.dev
# NUXT_PUBLIC_AUTHENTICATION_CLIENT_API_BASE=https://frigear-nu.frigear.workers.dev
# NUXT_PUBLIC_AUTHENTICATION_CLIENT_CLIENT_ID=<the production app's client id>

# Override of identity.ts's scopes, space separated (keep openid).
# NUXT_PUBLIC_AUTHENTICATION_CLIENT_SCOPE=openid profile email
