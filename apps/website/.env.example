# Required to run this app locally (or in any environment) - this is the password used to encrypt the session cookie
NUXT_SESSION_PASSWORD=some-very-long-password


# Stripe (@frigear-nu/stripe + @frigear-nu/subscriptions)
####################################################
NUXT_STRIPE_SECRET_KEY=sk_test_...
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: lookup key of the Stripe price for the "member" plan (default: frigear_member_yearly)
# SUBSCRIPTIONS_MEMBER_LOOKUP_KEY=frigear_member_yearly


# OAuth server (@frigear-nu/oauth-server)
####################################################
# RSA key used to sign tokens. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}'
# The public key is derived from it and published at /.well-known/jwks.json.
# NUXT_OAUTH_SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# While rotating: public half of the retired key, as JSON keyed by its kid (see the docs)
# NUXT_OAUTH_SERVER_PREVIOUS_PUBLIC_KEYS='{"key-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}'
# Comma separated emails allowed to manage OAuth applications (see server/plugins/oauth-policy.ts)
# NUXT_OAUTH_ADMIN_EMAILS=admin@example.com


# Required for Cloudflare worker deployment
####################################################
# DEPLOYMENT_HOST=your-deployment-host.com
# CLOUDFLARE_WORKER_NAME=your-cloudflare-worker-name
# NUXT_HUB_CLOUDFLARE_DATABASE_ID=your-cloudflare-database-id
# NUXT_HUB_CLOUDFLARE_KV_NAMESPACE_ID=your-cloudflare-kv-namespace-id


# Required for GitHub Actions automatic deployment
####################################################
# This will be required in addition to the Cloudflare worker vars (above)
# The fields will be set from the secrets/vars below - and MUST be set in the Github Repository Settings page (Settings > Secrets and variables > Actions)
# CLOUDFLARE_API_TOKEN="${{ secrets.CLOUDFLARE_API_TOKEN }}"
# CLOUDFLARE_ACCOUNT_ID="${{ secrets.CLOUDFLARE_ACCOUNT_ID }}"
# CLOUDFLARE_DB_NAME="${{ vars.CLOUDFLARE_DB_NAME }}"
# CLOUDFLARE_DOMAIN_ROOT="${{ vars.CLOUDFLARE_DOMAIN_ROOT }}"

# Notify - email delivery: log (default) | resend | ses | cloudflare
NUXT_NOTIFY_EMAIL_DRIVER=log
NUXT_NOTIFY_EMAIL_FROM="Frigear <no-reply@example.com>"
# resend
NUXT_NOTIFY_EMAIL_RESEND_API_TOKEN=
# ses
NUXT_NOTIFY_EMAIL_SES_REGION=
NUXT_NOTIFY_EMAIL_SES_ACCESS_KEY_ID=
NUXT_NOTIFY_EMAIL_SES_SECRET_ACCESS_KEY=
# cloudflare
NUXT_NOTIFY_EMAIL_CLOUDFLARE_ACCOUNT_ID=
NUXT_NOTIFY_EMAIL_CLOUDFLARE_API_TOKEN=

####################################################
# Log in with frigear.nu (@frigear-nu/users, oauth.frigear)
# Active on PR previews (PR_NUMBER) or when the SSO credentials below are set.
# Register an OAuth app on frigear.nu with the callback http://localhost:3045/auth/frigear
####################################################
FRIGEAR_SSO_URL=https://frigear.nu
FRIGEAR_SSO_CLIENT_ID=
FRIGEAR_SSO_CLIENT_SECRET=
# Alternative to the three above (nuxt-auth-utils' own OIDC config); used when FRIGEAR_SSO_* is empty
# NUXT_OAUTH_OIDC_CLIENT_ID=
# NUXT_OAUTH_OIDC_CLIENT_SECRET=
# NUXT_OAUTH_OIDC_OPENID_CONFIG=https://frigear.nu/.well-known/openid-configuration
# Use the frigear.nu user id as the local user id; existing users (same email) are re-keyed.
# NUXT_FRIGEAR_FORCE_ID=true
