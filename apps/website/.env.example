# Seals the session cookie (nuxt-auth-utils derives its key from Nuxt's appSecret). Leave it empty in development:
# Nuxt generates one. In production set 32+ characters, e.g. `openssl rand -base64 32` (shorter values are refused).
NUXT_APP_SECRET=
# Fallback encryption key for form submissions and stored OAuth tokens; keep it stable once data is encrypted
NUXT_SESSION_PASSWORD=some-very-long-password
# Comma separated emails that hold the `admin` role once verified (server/plugins/authorization-roles.ts). Admins
# assign every other role in the admin.
# NUXT_ACL_ADMINS=admin@example.com


# Stripe (@frigear-nu/stripe + @frigear-nu/subscriptions)
####################################################
NUXT_STRIPE_SECRET_KEY=sk_test_...
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: lookup key of the Stripe price for the "member" plan (default: frigear_member_yearly)
# SUBSCRIPTIONS_MEMBER_LOOKUP_KEY=frigear_member_yearly


# OAuth server (@frigear-nu/oauth-server)
####################################################
# RSA key used to sign tokens. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}'
# The public key is derived from it and published at /.well-known/jwks.json.
# NUXT_OAUTH_SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# While rotating: public half of the retired key, as JSON keyed by its kid (see the docs)
# NUXT_OAUTH_SERVER_PREVIOUS_PUBLIC_KEYS='{"key-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}'


# Required for Cloudflare worker deployment
####################################################
# DEPLOYMENT_HOST=your-deployment-host.com
# CLOUDFLARE_WORKER_NAME=your-cloudflare-worker-name
# NUXT_HUB_CLOUDFLARE_DATABASE_ID=your-cloudflare-database-id
# NUXT_HUB_CLOUDFLARE_KV_NAMESPACE_ID=your-cloudflare-kv-namespace-id


# Required for GitHub Actions automatic deployment
####################################################
# This will be required in addition to the Cloudflare worker vars (above)
# The fields will be set from the secrets/vars below - and MUST be set in the Github Repository Settings page (Settings > Secrets and variables > Actions)
# CLOUDFLARE_API_TOKEN="${{ secrets.CLOUDFLARE_API_TOKEN }}"
# CLOUDFLARE_ACCOUNT_ID="${{ secrets.CLOUDFLARE_ACCOUNT_ID }}"
# CLOUDFLARE_DB_NAME="${{ vars.CLOUDFLARE_DB_NAME }}"
# CLOUDFLARE_DOMAIN_ROOT="${{ vars.CLOUDFLARE_DOMAIN_ROOT }}"

# Notify - email delivery: log (default) | resend | ses | cloudflare
NUXT_NOTIFY_EMAIL_DRIVER=log
NUXT_NOTIFY_EMAIL_FROM="Frigear <no-reply@example.com>"
# resend
NUXT_NOTIFY_EMAIL_RESEND_API_TOKEN=
# ses
NUXT_NOTIFY_EMAIL_SES_REGION=
NUXT_NOTIFY_EMAIL_SES_ACCESS_KEY_ID=
NUXT_NOTIFY_EMAIL_SES_SECRET_ACCESS_KEY=
# cloudflare
NUXT_NOTIFY_EMAIL_CLOUDFLARE_ACCOUNT_ID=
NUXT_NOTIFY_EMAIL_CLOUDFLARE_API_TOKEN=
# Email templates branding: the logo path resolves against the site URL (https://$DEPLOYMENT_HOST, else https://frigear.nu)
# NUXT_EMAIL_TEMPLATES_SITE_URL=
# NUXT_EMAIL_TEMPLATES_LOGO_URL=

####################################################
# Log in with frigear.nu (@frigear-nu/users, oauth.frigear)
# Active on PR previews (PR_NUMBER) or when the SSO credentials below are set.
# Register an OAuth app on frigear.nu with the callback http://localhost:3045/auth/frigear
####################################################
FRIGEAR_SSO_URL=https://frigear.nu
FRIGEAR_SSO_CLIENT_ID=
FRIGEAR_SSO_CLIENT_SECRET=
# Alternative to the three above (nuxt-auth-utils' own OIDC config); used when FRIGEAR_SSO_* is empty
# NUXT_OAUTH_OIDC_CLIENT_ID=
# NUXT_OAUTH_OIDC_CLIENT_SECRET=
# NUXT_OAUTH_OIDC_OPENID_CONFIG=https://frigear.nu/.well-known/openid-configuration
# Use the frigear.nu user id as the local user id; existing users (same email) are re-keyed.
# NUXT_FRIGEAR_FORCE_ID=true

####################################################
# Volunteering modules
####################################################
# Shifts (@frigear-nu/shifts): the secret station QR codes are signed with. Without it station check-in is off (the
# lead's scan, location and daily check-in still work). A long random value of its own, at least 32 characters (a
# shorter one stops the server at startup): `openssl rand -base64 32`. Changing it invalidates the codes on screen for
# at most a minute.
NUXT_SHIFTS_STATION_KEY=

# Push (@frigear-nu/push). Without credentials pushes only go to the server log (the `log` delivery).
# log | providers. Unset: `providers` once any credentials are set, otherwise `log`.
# NUXT_PUSH_DELIVERY=
# Where an iOS device that registered without a provider goes: apns (the default) | fcm. Cloudflare Workers have no
# node:http2, so use `fcm` there and let the iOS app register its FCM token.
# NUXT_PUSH_IOS=fcm
# The whole service account JSON of the Firebase project, on one line (Project settings > Service accounts).
NUXT_PUSH_FCM_SERVICE_ACCOUNT=
# Only for sending to APNs directly (not needed when every iOS app goes through FCM). The .p8 key with literal \n.
# NUXT_PUSH_APNS_KEY_ID=
# NUXT_PUSH_APNS_TEAM_ID=
# NUXT_PUSH_APNS_TOPIC=<the app's bundle id>
# NUXT_PUSH_APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# NUXT_PUSH_APNS_SANDBOX=true
# NUXT_PUSH_TIMEOUT_MS=10000

# Inbox (@frigear-nu/inbox). Each webhook answers 501 until its secret is set.
# Mailboxes created on the first request when their key does not exist (never changed afterwards), as JSON. Staff can
# also create them at /admin/inbox/settings.
# NUXT_INBOX_MAILBOXES='[{"key":"<key>","name":{"da":"<name>","en":"<name>"},"grants":[{"kind":"role","role":"admin"}]}]'
# The HMAC secret of the inbound email webhook (`openssl rand -base64 32`), also entered at the email provider.
NUXT_INBOX_EMAIL_WEBHOOK_SECRET=
# The Meta app secret (Messenger, Instagram, WhatsApp), and a verify token you also enter at Meta.
NUXT_INBOX_META_APP_SECRET=
NUXT_INBOX_META_VERIFY_TOKEN=
# One per channel account secret ref declared in `inbox.secrets` (nuxt.config.ts): NUXT_INBOX_SECRETS_<REF>=...
# Or all of them as JSON: NUXT_INBOX_SECRETS='{"<REF>":"..."}'
